<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>1. Review of Calculus III</title>

  <exercise workspace="1in">
    <introduction>
      <p>Consider the vectors
  <md>A = (2,-3,2), ~~~ B = (-1,0,3).</md></p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>Find the dot products <m>A\cdot A</m> and <m>A\cdot B</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>How does this help you find the length of <m>A</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is the angle between <m>A</m> and <m>B</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>How can the dot product detect when two vectors are orthogonal?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If <m>C</m> is a vector and <m>C\cdot C=0</m>, what does this say about <m>C</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Find the cross product <m>A\times B</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Describe in words how you would find the direction in which <m>A\times
  B</m> points.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is <m>A\times A</m>?</p>
      </statement>
    </task>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>Shown below are a line and a circle.  Create a parametrization
  for each of the curves.  What choices have you made in forming your
  parametrizations and how might your parametrizations differ from a
  classmate's?</p>
      <p>\begin{center}
    \includegraphics{figures/01-line.eps}
    \hspace*{24pt}
    \includegraphics{figures/01-circle.eps}
  \end{center}</p>
    </statement>
  </exercise>

  <exercise workspace="1in">
    <introduction>
      <p>Consider the function <m>f(x,y) = x^2 - 2xy + y</m>.</p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>Find the gradient <m>\nabla f(x,y)</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If you are at the point <m>(1,1)</m>, what is the gradient there?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Suppose <m>f(x,y)</m> is measuring the elevation of a landscape in
  feet.  In what direction should you move from the point <m>(1,1)</m> to
  move most steeply uphill?  In what direction should you move to stay
  at the same elevation?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Suppose your motion in the plane is given by the function <m>r(t)
  = (t^2, t^3)</m>.  What is your location at time <m>t=1</m> and what is your
  velocity?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If <m>t</m> is measured in seconds, at what rate, in feet per
  second, are you moving uphill at <m>t=1</m>?</p>
      </statement>
    </task>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Sketch the field <m>F(x,y) = (y^2, 2x)</m> at the nine points
  <m>(x,y)</m> where <m>x</m> and <m>y</m> take on the values <m>-1</m>, <m>0</m>, and <m>1</m>.
  (You don't necessarily need to draw the vectors to scale.)</p>
    </statement>
  </exercise>

</worksheet>
