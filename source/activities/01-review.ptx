<exercise>
  <introduction>
    <p>
      Shown below are a line and a circle. 
    </p>
    <!--><image source="figures/01-line.eps" /><p /><image source="figures/01-circle.eps" /> <-->
    <sidebyside widths="35% 35%">
<image>
  <shortdescription>insert alt text here</shortdescription>
  <prefigure xmlns="https://prefigure.org" label="prefigure-line">
    <diagram dimensions="(250,250)" margins="5">
      <definition>f(x)=1.5-1/2*x</definition>
      <coordinates bbox="(-4,-4,4,4)">
        <grid-axes xlabel="x" ylabel="y"/>
        <graph at="graph" function="f"/>
      </coordinates>
    </diagram>
  </prefigure>
</image>
<image>
    <shortdescription>insert alt text here</shortdescription>
  <prefigure xmlns="https://prefigure.org" label="prefigure-circle">
    <diagram dimensions="(250,250)" margins="5">
      <coordinates bbox="(-4,-4,4,4)">
        <grid-axes xlabel="x" ylabel="y"/>
        <circle center="(-1,1)" radius="2" stroke="blue"/>
      </coordinates>
    </diagram>
  </prefigure>
</image>
</sidebyside>
  </introduction>
  <task workspace="0.5in">
    <statement>
      <p>
        Create a parametrization for each of the curves. 
      </p>
    </statement>
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        What choices have you made in forming your parametrizations and how might your parametrizations differ from a classmate's?
      </p>
    </statement>
  </task>
</exercise>




<exercise>
  <introduction>
    <p>
      Consider the function <m>f(x,y) = x^{2} - 2xy + y</m>.
    </p>
  </introduction>
  <task workspace="0.8in">
    <statement>
      <p>
        Find the gradient <m>\nabla f(x,y)</m>.
      </p>
    </statement>
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        If you are at the point <m>(1,1)</m>, what is the gradient there?
      </p>
    </statement>
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        Suppose <m>f(x,y)</m> is measuring the elevation of a landscape in feet. In what direction should you move from the point <m>(1,1)</m> to move most steeply uphill? In what direction should you move to stay at the same elevation?
      </p>
    </statement>
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        Suppose your motion in the plane is given by the function <m>r(t) = (t^{2}, t^{3})</m>. What is your location at time <m>t=1</m> and what is your velocity?
      </p>
    </statement>
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        If <m>t</m> is measured in seconds, at what rate, in feet per second, are you moving uphill at <m>t=1</m>?
      </p>
    </statement>
  </task>
</exercise>

<exercise workspace="1in">
  <introduction>
    <p>
      Sketch the field <m>F(x,y) = (y^{2}, 2x)</m> at the nine points <m>(x,y)</m> where <m>x</m> and <m>y</m> take on the values <m>-1</m>, <m>0</m>, and <m>1</m>. (You don't necessarily need to draw the vectors to scale.)
    </p>
  </introduction>
</exercise>



