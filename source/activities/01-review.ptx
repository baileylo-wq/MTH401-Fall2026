    <exercise>
        <introduction>
            <p>
                Shown below are a line and a circle.
            </p>
            <!--><image source="figures/01-line.eps" /><p /><image source="figures/01-circle.eps" /> <-->
            <sidebyside widths="30% 30%">
                <image>
                    <shortdescription>
                        The graph of a line, see description below for more
                        information.
                    </shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefigure-line">
                        <diagram dimensions="(250,250)" margins="5">
                            <definition>
                                f(x)=1.5-1/2*x
                            </definition>
                            <coordinates bbox="(-4,-4,4,4)">
                                <grid-axes xlabel="x" ylabel="y"/>
                                <graph at="graph" function="f"/>
                            </coordinates>
                        </diagram>
                    </prefigure>

                    <description>
                        <p>
                            The graph of a line that goes through the points
                            <m>(-1,2)</m> and <m>(1,1)</m>.
                        </p>
                    </description>
                </image>

                <image>
                    <shortdescription>
                        The graph of a circle, see description below for more
                        information.
                    </shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefigure-circle">
                        <diagram dimensions="(250,250)" margins="5">
                            <coordinates bbox="(-4,-4,4,4)">
                                <grid-axes xlabel="x" ylabel="y"/>
                                <circle center="(-1,1)" radius="2" stroke="blue"/>
                            </coordinates>
                        </diagram>
                    </prefigure>

                    <description>
                        <p>
                            The graph of a circle with radius <m>2</m> centered
                            at <m>(-1,-1)</m>.
                        </p>
                    </description>
                </image>
            </sidebyside>
        </introduction>

        <task workspace="0.5in">
            <statement>
                <p>
                    Create a parametrization for each of the curves.
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    There are many different parameterizations.  One way is:
                </p>
                <p>
                    For the line, choose <m>\vec{r}_0=(1,1)</m>, then the line 
                    moves along by <m>\vec{v}=(2,-1)</m>, so <m>{\vec{r}(t)=(1,1)+t(2,1)
                        = (1+2t, 1-t)}
                    </m>.
                </p>
                <p>
                    For the circle, it has center <m>\vec{r}_0=(-1,1)</m> and radius 
                    <m>\rho = 2</m>, so <m>{\vec{r}(t) = (-1,1) + 2(\cos{t}, \sin{t}) 
                        = (-1 + 2\cos{t}, 1+2\sin{t})}</m>.
                </p>
            </solution>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    What choices have you made in forming your parametrizations
                    and how might your parametrizations differ from a
                    classmate's?
                </p>
            </statement>
        </task>
    </exercise>

    <exercise>
        <introduction>
            <p>
                Consider the function <m>f(x,y) = x^{2} - 2xy + y</m>.
            </p>
        </introduction>

        <task workspace="0.8in">
            <statement>
                <p>
                    Find the gradient <m>\nabla f(x,y)</m>.
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>\ds \nabla f = \left(\frac{\partial f}{\partial x}, \frac{\partial f}{\partial y} \right) = (2x-2y, -2x+1)</m>
                </p>
            </solution>
        </task>

        <task workspace="0.8in">
            <statement>
                <p>
                    If you are at the point <m>(1,1)</m>, what is the gradient
                    there?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>\nabla f(1,1) = (0,-1)</m>
                </p>
            </solution>
        </task>

        <task workspace="0.8in">
            <statement>
                <p>
                    Suppose <m>f(x,y)</m> is measuring the elevation of a
                    landscape in feet.
                    In what direction should you move from the point
                    <m>(1,1)</m> to move most steeply uphill?
                    In what direction should you move to stay at the same
                    elevation?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    The gradient points in the direction of steepest ascent, 
                    so you should go in the direction <m>(0,-1)</m> to go uphill
                    the fastest. The gradient is perpendicular to the level curve (
                        where elevation is the same
                    ), so <m>(1,0)</m> since it's perpendicular to the gradient at that point.
                </p>
            </solution>
        </task>

        <task workspace="0.8in">
            <statement>
                <p>
                    Suppose your motion in the plane is given by the function
                    <m>r(t) = (t^{2}, t^{3})</m>.
                    What is your location at time <m>t=1</m> and what is your
                    velocity?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    location: <m>\vec{r}(1) = (1,1)</m>
                </p>
                <p>
                    velocity: <m>\vec{v}(t) = \vec{r}'(t) = (2t, 3t^2)</m> so <m>\vec{v}(1) = (2,3)</m>
                </p>
            </solution>
        </task>

        <task workspace="0.8in">
            <statement>
                <p>
                    If <m>t</m> is measured in seconds, at what rate, in feet
                    per second, are you moving uphill at <m>t=1</m>?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>\ds \frac{\partial f}{\partial t} = \nabla f(1,1) \cdot \vec{v}(1) = (0,-1)\cdot (2,3) = -3</m> ft/s
                </p>
            </solution>
        </task>
    </exercise>

    <exercise workspace="1in">
        <statement>
            <p>
                Sketch the field <m>F(x,y) = (y^{2}, 2x)</m> at the nine points
                <m>(x,y)</m> where <m>x</m> and <m>y</m> take on the values
                <m>-1</m>, <m>0</m>, and <m>1</m>.
                (You don't necessarily need to draw the vectors to scale.)
            </p>
        </statement>
        <solution component="show-soln">
                <image width="40%">
                    <shortdescription></shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefigure-401-0-soln">
 <diagram dimensions="(300,300)" margins="10">
  <definition>f(t,y) = (y[1]^2,2*y[0])</definition>
  <coordinates bbox="[-2,-2,2,2]">
    <grid-axes xlabel="x" ylabel="y"/>
    <slope-field function="f" system="yes" arrows="yes"/>
    <point p="(0,0)"/>
    <point p="(0,1)"/>
    <point p="(1,1)"/>
    <point p="(1,0)"/>
    <point p="(1,-1)"/>
    <point p="(0,-1)"/>
    <point p="(-1,-1)"/>
    <point p="(-1,0)"/>
    <point p="(-1,1)"/>
  </coordinates>
</diagram>
                        </prefigure>
                </image>
            </solution>
    </exercise>

</worksheet>