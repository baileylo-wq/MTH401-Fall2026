    <objectives>
        <introduction>
            <p>
                It's important we recall the following ideas which we will use
                throughout this class:
            </p>
        </introduction>

        <ul>
            <li>
                <p>
                    The dot product and the cross product.
                </p>
            </li>

            <li>
                <p>
                    How to parameterize a curve.
                </p>
            </li>

            <li>
                <p>
                    The gradient of a function.
                </p>
            </li>

            <li>
                <p>
                    Fields.
                </p>
            </li>
        </ul>
    </objectives>

    <exercise xml:id="exr-x">
        <introduction>
            <p>
                Consider the vectors
                <md>
                    <mrow> A \amp = (2,-3,2),  \amp  B \amp= (-1,0,3). </mrow>
                </md>
            </p>
        </introduction>

        <task workspace="0.6in">
            <statement>
                <p>
                    Find the dot products <m>A\cdot A</m> and <m>A\cdot B</m>.
                </p>
            </statement>

            <solution component="show-soln">
                <p>
                    <m>
            A\cdot A  = 2^2 + (-3)^2+2^2  = 17
          </m>
        </p>
        <p>
            <m>A\cdot B  =(2)(-1)+(-3)(0)+(2)(3) =4
        </m>
                 
                </p>
            </solution>
        </task>

        <task workspace="0.6in">
            <statement>
                <p>
                    How does this help you find the length of <m>A</m>?
                </p>
            </statement>
            <solution component = "show-soln">
                <p>
                    <m>|A| = \sqrt{A\cdot A} = \sqrt{17}</m>
                </p>
            </solution>
        </task>

        <task workspace="0.6in">
            <statement>
                <p>
                    What is the angle between <m>A</m> and <m>B</m>?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>A\cdot B = |A| |B| \cos{\theta}</m>
                </p>
                <p>
                    <m>\theta = \cos^{-1}{\frac{A\cdot B}{|A| |B|}} = \cos^{-1}{\frac{4}{\sqrt{17}\sqrt{10}}} \approx 72.134^{\circ}</m>
                </p>
            </solution>
        </task>

        <task workspace="0.6in">
            <statement>
                <p>
                    How can the dot product detect when two vectors are
                    orthogonal?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    Two vectors are orthogonal if and only if their dot product is 0.
                </p>
            </solution>
        </task>

        <task workspace="0.6in">
            <statement>
                <p>
                    If <m>C</m> is a vector and <m>C\cdot C=0</m>, what does
                    this say about <m>C</m>?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>C</m> is orthogonal to itself, so <m>C</m> is the zero vector.
                </p>
            </solution>
        </task>

        <task workspace="0.8in">
            <statement>
                <p>
                    Find the cross product <m>A\times B</m>.
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>A\times B = \begin{vmatrix}\vec{i} \amp \vec{j}\amp \vec{k}
                         \\ 2\amp-3 \amp 2 \\ -1 \amp 0 \amp 3\end{vmatrix} =
                          (-9,-8,-3)</m>
                </p>
            </solution>
            <!--> <answer>...</answer> <-->
        </task>

        <task workspace="0.6in">
            <statement>
                <p>
                    Describe in words how you would find the direction in which
                    <m>A\times B</m> points.
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    Right palm points in direction of <m>A</m>, fingers sweep towards 
                    <m>B</m>, your thumb points in the direction of <m>A\times B</m>
                </p>
            </solution>
            <!--> <answer>...</answer> <-->
        </task>

        <task workspace="0.8in">
            <statement>
                <p>
                    What is <m> A\times A</m>?
                </p>
            </statement>
            <solution component="show-soln">
                <p>
                    <m>A\times A=\vec{0}</m> since <m>A</m> is parallel to itself
                </p>
            </solution>
            <!--> <answer>...</answer> <-->
        </task>
    </exercise>
