<worksheet>
  <title> 1. Review of Calculus III </title>


  <alert>MTH 401</alert> 
  

<exercise xml:id="exr-x">
  <introduction>
    <p>
      Consider the vectors
        <md>
          <mrow> A \amp = (2,-3,2),  \amp  B \amp= (-1,0,3). </mrow>
        </md>
    </p>
  </introduction>
  <task workspace="0.8in">
    <statement>
      <p>
        Find the dot products <m>A\cdot A</m> and <m>A\cdot B</m>.
      </p>
    </statement>
    <solution component="week1">
      <p>
        <md>
          <mrow>
            A\cdot A \amp = 2^2 + (-3)^2+2^2  = 17
          </mrow>
          <mrow>
            A\cdot B \amp =(2)(-1)+(-3)(0)+(2)(3) =4
          </mrow>
        </md>
      </p>
    </solution>
    <answer>
      <p>
        <md>
          A\cdot A = 17, \ \ \ A\cdot B = 4
        </md>
      </p>
    </answer>
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        How does this help you find the length of <m>A</m>?
      </p>
    </statement>
   <!--> <answer>...</answer> <-->
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        What is the angle between <m>A</m> and <m>B</m>?
      </p>
    </statement>
    <!--> <answer>...</answer> <-->
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        How can the dot product detect when two vectors are orthogonal?
      </p>
    </statement>
    <!--> <answer>...</answer> <-->
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        If <m>C</m> is a vector and <m>C\cdot C=0</m>, what does this say about <m>C</m>?
      </p>
    </statement>
    <!--> <answer>...</answer> <-->
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        Find the cross product <m>A\times B</m>.
      </p>
    </statement>
    <!--> <answer>...</answer> <-->
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        Describe in words how you would find the direction in which <m>A\times B</m> points.
      </p>
    </statement>
    <!--> <answer>...</answer> <-->
  </task>
  <task workspace="0.8in">
    <statement>
      <p>
        What is <m> A\times A</m>?
      </p>
    </statement>
    <!--> <answer>...</answer> <-->
  </task>
</exercise>



