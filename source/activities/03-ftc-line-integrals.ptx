<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
    <title>1.2. The FTC of line integrals</title>

    <alert>
        MTH 401
    </alert>

    <definition xml:id="def-conservative-field">
        <statement>
            <p>
                A field <m>\mbf F</m> is <term>conservative</term> if there
                exists some function <m>f</m> for which <m>{F = \nabla f}</m>.
                The function <m>f</m> is called the
                <term>potential function for <m>\mbf F</m></term>.
            </p>

            <p>
                (Note that physicists usually use <m>F=-\nabla f</m>, but it is
                essentially the same.)
            </p>
        </statement>
    </definition>

    <theorem xml:id="thm-conservative-FTC">
        <statement>
            <p>
                The <term>FTC for line integrals</term>: if <m>\mbf F</m> is
                conservative and <m>\mbf F = \nabla f</m>, then
                <md>
                    \lineint{C}{F} = f(Q)-f(P)
                </md>
                where <m>C</m> goes from point <m>P</m> to point <m>Q</m>.
            </p>
        </statement>
    </theorem>

    <exercise workspace="1.25in">
        <introduction>
            <p>
                Suppose that <m>{\mathbf F} = \nabla f</m> where
                <m>f(x,y) = 3x^2y -
  \sin(x) + e^y</m>.
            </p>
        </introduction>

        <task workspace="1in">
            <statement>
                <p>
                    Find the coordinates of the field <m>{\mathbf F}</m>.
                </p>
            </statement>
        </task>

        <task workspace="1.25in">
            <statement>
                <p>
                    Evaluate <m>\lineint{C_1}{F}</m> where <m>C_1</m> is the
                    upper half of the unit circle oriented in the
                    counter-clockwise direction.
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Evaluate <m>\lineint{C_2}{F}</m> where <m>C_2</m> is the
                    straight line segment from <m>(1,0)</m> to <m>(-1,0)</m>.
                </p>
            </statement>
        </task>
    </exercise>

    <exercise workspace="0.1in">
        <statement>
            <p>
                Suppose that <m>{\mathbf F}(x,y) = (2x, 3y)</m>.
                Evaluate
                <md>
                    \lineint{C_1}{F}, ~~~
  \lineint{C_2}{F}
                </md>
                where <m>C_1</m> and <m>C_2</m> are the curves as shown below (<m>C_1</m> has two pieces!).
            </p>

            <image width="30%" margins="0% 70%">
                <shortdescription>
                    The graph of three line segments with directions, see
                    description below.
                </shortdescription>
                <prefigure xmlns="https://prefigure.org" label="prefigure-3-line-integral">
                    <diagram dimensions="(250,250)" margins="5">
                        <coordinates bbox="(-1,-1,4,4)">
                            <grid-axes spacings="((-1,1,4),(-1,1,4))" xlabel="x" ylabel="y"/>
                            <vector v="(-2,0)" tail="(2,0)" stroke="blue" head-location="0.8"/>
                            <vector v="(-2,2)" tail="(2,0)" stroke="blue" head-location="0.8"/>
                            <vector v="(0,2)" tail="(0,0)" stroke="blue" head-location="0.8"/>
                            <label anchor="(1.5,0)" alignment="south" offset="(0,-5)">
                                <m>
                                    \displaystyle C_1
                                </m>
                            </label>
                            <label anchor="(1,1)" alignment="ne" offset="(5,5)">
                                <m>
                                    \displaystyle C_2
                                </m>
                            </label>
                        </coordinates>
                    </diagram>
                </prefigure>

                <description>
                    <p>
                        Three directional curves are shown, <m>C_1</m> is the
                        straight line from <m>(2,0)</m> to <m>(0,0)</m>,
                        <m>C_2</m> is the line from <m>(2,0)</m> to
                        <m>(0,2)</m>, and the third line goes from <m>(0,0)</m>
                        to <m>(0,2)</m>.
                    </p>
                </description>
            </image>
        </statement>
    </exercise>

    <exercise>
        <introduction>
            <p>
                Let's look closer at fields and the concept of a conservative field.
            </p>
        </introduction>

        <task workspace="0.5in">
            <statement>
                <p>
                    Assume <m>C</m> is a closed curve; that is, <m>C</m> has the
                    same initial and final point.
                    If <m>{\mathbf F}</m> is a conservative vector field, what
                    is the line integral <m>\lineint{C}{F}</m>?
                    (Note: we often write such as integral as
                    <m>\olineint{C}{F}</m> to denote the fact that <m>C</m> is
                    closed.) Explain your response.
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Suppose that
                    <md>
                        {\mathbf F}(x,y) = \left(-\frac{y}{x^2+y^2},
    \frac{x}{x^2+y^2}\right)
                    </md>
                    and <m>C</m> is the unit circle traversed one time in the
                    counter-clockwise direction.
                    Find the line integral <m>\olineint{C}{F}</m>.
                    (You did this last worksheet.)
                </p>
            </statement>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    Is <m>{\mathbf F}</m> in the previous part conservative?
                    Explain your response.
                </p>
            </statement>
        </task>
    </exercise>

    <exercise workspace="1.5in">
        <statement>
            <p>
                Suppose that <m>C</m> is the curve parametrized by
                <m>{\mathbf r}(t) = (t^2, t^3, t-1)</m> where
                <m>1\leq t \leq 2</m>.
                Evaluate the line integral
                <md>
                    \int_C ye^z~dx + xe^z~dy + xye^z~dz.
                </md>
            </p>
        </statement>
    </exercise>

    <exercise workspace=".5in">
        <statement>
            <p>
                Which, if either, of the fields below could be conservative?
                Explain your response.
            </p>

            <sidebyside widths="30% 30%">
                <image>
                    <shortdescription>
                        A vector field, all vectors point radially away from the
                        origin.
                    </shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefigure-3-slope1">
                        <diagram dimensions="(200,200)" margins="5">
                            <definition>
                                f(x,y) = (x,y)
                            </definition>
                            <coordinates bbox="[-4,-4,4,4]">
                                <grid-axes xlabel="x" ylabel="y" decorations="no"/>
                                <vector-field function="f"/>
                            </coordinates>
                        </diagram>
                    </prefigure>
                </image>

                <image>
                    <shortdescription>
                        A vector field, all arrows points counter-clockwise in a
                        co-centric circles centered around the origin.
                    </shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefigure-3-slope2">
                        <diagram dimensions="(200,200)" margins="5">
                            <definition>
                                f(x,y) = (-y,x)
                            </definition>
                            <coordinates bbox="[-4,-4,4,4]">
                                <grid-axes xlabel="x" ylabel="y" decorations="no"/>
                                <vector-field function="f"/>
                            </coordinates>
                        </diagram>
                    </prefigure>
                </image>
            </sidebyside>
        </statement>
    </exercise>

    <exercise>
        <introduction>
            <p>
                From MTH 203 (Calculus III), you may remember that the second
                mixed partials of a reasonable function <m>f(x,y)</m> are equal;
                that is,
                <md>
                    \frac{\partial^2 f}{\partial x\partial y} =
  \frac{\partial^2 f}{\partial y\partial x}.
                </md>
                That is, it doesn't matter in which order we compute second
                mixed partials.
            </p>

            <p>
                This gives us a simple test to determine when a field
                <m>{\mathbf
    F}(x,y)</m> is conservative.
            </p>
        </introduction>

        <task workspace="1in">
            <statement>
                <p>
                    If <m>
  {\mathbf F}(x,y) = (F_1(x,y), F_2(x,y))
  </m> is
                    conservative, what relationship must hold between <m>F_1</m>
                    and <m>F_2</m>?
                </p>
            </statement>
        </task>

        <task workspace="1.2in">
            <statement>
                <p>
                    Verify that this relationship holds for the field in
                    problems 1 and 2.
                </p>
            </statement>
        </task>

        <task workspace=".7in">
            <statement>
                <p>
                    Does this relationship hold for the field in problem 3?
                </p>
            </statement>
        </task>
    </exercise>
</worksheet>