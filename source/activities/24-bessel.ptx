<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>2.15. PDEs on cylinders</title>
  <alert>MTH 401</alert>

  <exercise workspace="5in">
    <statement>
      <p>Together we found the general solution to the wave equation on a disk. Using that 
        same process, find the general solution to the heat equation
  <md>
  \pd{u}{t} = \alpha \nabla^2 u
  </md>
  on a disk of radius <m>a</m> assuming the temperature on the boundary is
  constantly zero.</p>
    </statement>
  </exercise>

  <exercise workspace="5in">
    <statement>
      <p>Find the general solution to Laplace's equation <m>\nabla^2 u = 0</m>
  in a cylinder of radius <m>R</m> and height <m>H</m> assuming that <m>u=0</m> on
  the bottom of the cylinder and the curvy side but not necessarily
  the top. (What kind of coordinates would be good here?)</p>
    </statement>
  </exercise>

  <exercise workspace="5in">
    <statement>
      <p>Find the general solution to the wave equation
  <md>
  \pdtwo{u}{t}=v^2\nabla^2 u
  </md>
  in a cylinder of radius <m>R</m> and height <m>H</m> assuming that <m>u=0</m> on
  the boundary of the cylinder.</p>
    </statement>
  </exercise>

</worksheet>
