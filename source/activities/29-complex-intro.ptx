<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>3.1. Complex arithmetic</title>
  <alert>MTH 401</alert>

  <subsection xml:id="subsubsec-complex-analysis">
    <title>Section 3: Complex Analysis</title>
    <subsubsection>
      <title>Part 3.1: Complex Arithmetic</title>
      
      <introduction>
        <p>
          The last portion of this class will complex analysis.
          In particular, here we will focus on complex arithmetic.
        </p>
      </introduction>
    </subsubsection>
  </subsection>

<fact xml:id="fact-euler-again">
  <statement>
    <p>
      Recall some facts. Firstly the <term>imaginary number</term> <m>{i = \sqrt{-1}}</m> where 
      <m>{i^2 = -1}</m>. Recall <term>Euler's formula</term>:
      <md>
        e^{i\theta} = \cos(\theta) + i\sin(\theta)
      </md>
      <term>Cartesian form</term> of a complex number: <md>z = x+iy</md>, where the <term>real part</term> of <m>z</m> is 
      <m>{Re(z) = x}</m> and the <term>imaginary part</term> is <m>{Im(z) = y}</m>. (Note the imaginary part is a
      real number!) The <term>polar form</term> is <md>z = re^{i\theta}</md> where <m>{r = |z| = \sqrt{x^2+y^2}}</m> is the 
      <term>modulus</term> and <m>{\theta = arg(z) = \arctan(\frac{y}{x})}</m> is the <term>argument</term>.
    </p>
  </statement>
</fact>


  <exercise>
    <introduction>
      <p>
        Going between Cartesian and Polar form.
      </p>
    </introduction>
    <task workspace="0in">
      <statement>
        <p>For both complex numbers <m>1+i</m> and <m>-2i</m>, plot the number below
  and determine its modulus <m>|z|</m> and argument.  
  Then express it in
  polar form <m>re^{i\theta}</m>.</p>
        <image width="25%" margins="0% 75%">
    <shortdescription>Coordinates to plot complex numbers.</shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-3-1-grid1">
        <diagram dimensions="(250,250)" margins="5">
          <coordinates bbox="(-4,-4,4,4)">
            <grid-axes  xlabel="Re(z)" ylabel="Im(z)"/>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
      </statement>
    </task>
    <task workspace="0in">
      <statement>
        <p>For both complex numbers <m>2e^{3i\pi/4}</m> and <m>e^{-7i\pi/2}</m>, plot the
  number below and determine its modulus and argument.  Then express
  it in Cartesian form <m>a+bi</m>.</p>
  <image width="25%" margins="0% 75%">
    <shortdescription>Coordinates to plot complex numbers.</shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-3-1-grid2">
        <diagram dimensions="(250,250)" margins="5">
          <coordinates bbox="(-4,-4,4,4)">
            <grid-axes  xlabel="Re(z)" ylabel="Im(z)"/>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
      </statement>
    </task>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Find the products <m>(3+2i)(4-i)</m> and <m>(2e^{5i\pi/4})(4e^{-i\pi})</m>.</p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>The <term>conjugate</term> of a complex number <m>a+bi</m> is the new
  complex number <m>\overline{a+bi} = a-bi</m>.</p>
    </introduction>
    <task workspace="0in">
      <statement>
        <p>Plot the complex number <m>2-3i</m> and its conjugate <m>\overline{2-3i}</m>.
  Then plot the complex number <m>4e^{3i\pi/4}</m> and its conjugate
  <m>\overline{4e^{3i\pi/4}}</m>.</p>
        <image width="25%" margins="0% 75%">
    <shortdescription>Coordinates to plot complex numbers.</shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-3-1-grid3">
        <diagram dimensions="(250,250)" margins="5">
          <coordinates bbox="(-4,-4,4,4)">
            <grid-axes  xlabel="Re(z)" ylabel="Im(z)"/>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
      </statement>
    </task>
    <task workspace=".8in">
      <statement>
        <p>How can you write the conjugate <m>\overline{re^{i\theta}}</m> in polar
  form?</p>
      </statement>
    </task>
    <task workspace=".8in">
      <statement>
        <p>Find the product <m>(a+bi)(\overline{a+bi})</m>.  How is this quantity
  related to the modulus <m>|a+bi|</m>?</p>
      </statement>
    </task>
    <task workspace=".8in">
      <statement>
        <p>Explain why <m>\ds\frac1{a+bi} = \frac{\overline{a+bi}}{|a+bi|^2}</m>.</p>
      </statement>
    </task>
    <task workspace=".8in">
      <statement>
        <p>Find the reciprocal of <m>2+3i</m> and the reciprocal of <m>i</m>.</p>
      </statement>
    </task>
    <task workspace=".8in">
      <statement>
        <p>Find the reciprocal of <m>2e^{3i\pi/4}</m>.  More generally, what is the
  reciprocal of <m>re^{i\theta}</m>?</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>Let's think about the function <m>f(z) = z^2</m>.</p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>Writing <m>z=x+iy</m>,
  write <m>f(z)</m> in Cartesian form and identify functions <m>u(x,y)</m> and
  <m>v(x,y)</m> such that <m>f(x+iy) = u(x,y) + iv(x,y)</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If <m>z=re^{i\theta}</m>, write <m>f(re^{i\theta})</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What are the conditions on <m>r</m> and <m>\theta</m> for <m>f(re^{i\theta}) =
  -1</m>?  Remember that <m>\theta</m> is not restricted to lie in the
  interval <m>0\leq\theta&lt;2\pi</m>.</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Different functions.
      </p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>Suppose that <m>f(z) =z^4</m>.  Find and plot all the complex numbers
  where <m>f(z) = -1</m>.  If may be a good idea to think in terms of the
  polar form of <m>z</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Find and plot all the complex numbers where <m>z^8 = 1</m>.</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Separate the real and imaginary parts. 
      </p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>If we define <m>f(z) = e^{z} = e^{x+iy} = e^xe^{iy}</m>, find
  functions <m>u(x,y)</m> and <m>v(x,y)</m> such that <md>{e^{x+iy} = u(x,y) +
  iv(x,y)}</md>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Suppose that <m>e^{z_1} = e^{z_2}</m>.  What can you say about the
  relationship between <m>z_1</m> and <m>z_2</m>?</p>
      </statement>
    </task>
  </exercise>

</worksheet>
