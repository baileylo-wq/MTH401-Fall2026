<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>3.2. Complex functions</title>
  <alert>MTH 401</alert>

    <introduction>
    <p>
      We want to spend some time exploring complex functions <m>f(z)</m> where <m>z = x+iy</m>.
    </p>
  </introduction>

  <exercise >
    <introduction>
      <p>Consider the function <m>f(z) = e^z = e^xe^{iy}</m>.</p>
    </introduction>
    <task workspace="0in">
      <statement>
        <p>Plot the following points, and describe what happens to <m>f(1+iy)</m> as <m>y</m> varies.
  <m>f(z)</m> when</p>
<sidebyside widths="23% 77%">
  <image>
    <shortdescription>Coordinates to plot complex numbers.</shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-3-2-grid1">
        <diagram dimensions="(250,250)" margins="5">
          <coordinates bbox="(-4,-4,4,4)">
            <grid-axes  xlabel="Re(z)" ylabel="Im(z)"/>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
    <ul>
      <li>
        <p>
          <m>\ds z=1+i\frac{\pi}{2}</m>
        </p>
      </li>
      <li>
        <p>
          <m>z=1+i\pi</m>
        </p>
      </li>
      <li>
        <p>
          <m>z=1+i2\pi</m>
        </p>
      </li>
    </ul>
</sidebyside>

      </statement>
    </task>
    <task workspace="0in">
      <statement>
        <p>Plot the following points, and describe what happens to <m>\ds f(x+i\frac{\pi}{4})</m> as <m>y</m> varies.</p>
 <sidebyside widths="23% 77%">
  <image>
    <shortdescription>Coordinates to plot complex numbers.</shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-3-2-grid2">
        <diagram dimensions="(250,250)" margins="5">
          <coordinates bbox="(-4,-4,4,4)">
            <grid-axes  xlabel="Re(z)" ylabel="Im(z)"/>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
    <ul>
      <li>
        <p>
          <m>\ds z=-1+i\frac{\pi}{4}</m>
        </p>
      </li>
      <li>
        <p>
          <m>\ds z= 0+i\frac{\pi}4</m>
        </p>
      </li>
      <li>
        <p>
          <m>\ds z=1+i\frac{\pi}4</m>
        </p>
      </li>
      <li>
        <p>
          <m>\ds z=2+i\frac{\pi}4</m>
        </p>
      </li>
    </ul>
</sidebyside>
    </statement>
    </task>
    <task workspace="0.7in">
      <statement>
        <p>Since <m>f(z) = e^xe^{iy}</m>, what is <m>|f(z)|</m>?  What is <m>\arg(f(z))</m>?</p>
      </statement>
    </task>
    <task workspace="0.7in">
      <statement>
        <p>If we fix the value of <m>y=y_0</m>, what is the image of a horizontal
  line <m>f(x + iy_0)</m> as <m>x</m> varies?</p>
      </statement>
    </task>
    <task workspace="0.7in">
      <statement>
        <p>If we fix the value of <m>x=x_0</m>, what is the image of a vertical line
  <m>f(x_0 + iy)</m> as <m>y</m> varies?</p>
      </statement>
    </task>
    <task workspace="0.9in">
      <statement>
        <p>Given a square grid in the <m>z</m>-plane, sketch its image in the
  <m>w=f(z)</m> plane.</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>Remember that the natural logarithm is defined to be the inverse
  of the exponential function;  that is, <m>\ln(z) = w</m> if <m>e^w = z</m>.</p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>Find the points <m>w</m> that satisfy <m>e^w = -1</m>.  How many are there and
  how are they related to one another?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Defining <m>\ln(x+iy) = u + iv</m> means that <m>e^{u+iv}=e^ue^{iv}=x+iy</m>.
  Write <m>u</m> and <m>v</m> as functions of <m>x</m> and <m>y</m>.  Are both of these
  functions continuously defined?</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>Suppose that <m>\ds m = 2e^{i\frac{\pi}4}</m> and suppose that <m>z</m> is complex
  number.</p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>How does <m>|mz|</m> compare to <m>|z|</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>How does <m>\arg(mz)</m> compare to <m>\arg(z)</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is the geometric effect of multiplying <m>z</m> by <m>m</m> to obtain
  <m>mz</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Suppose that <m>f(z) = mz</m>.  
  Given a square grid in the <m>z</m>-plane, sketch its image in the
  <m>w=f(z)</m> plane.</p>
      </statement>
    </task>
  </exercise>

  <exercise >
    <introduction>
      <p>Suppose that <m>f(z) = z^2</m>.  Let's write <m>z=re^{i\theta}</m> in
  polar form.</p>
    </introduction>
    <task workspace=".6in">
      <statement>
        <p>What is <m>f(re^{i\theta})</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If we hold <m>r=r_0</m> fixed, what is the image of the circle
  <m>f(r_0e^{i\theta})</m> as <m>\theta</m> varies?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If we hold <m>\theta=\theta_0</m> fixed, what is the image of the ray
  <m>f(re^{i\theta})</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Instead of a square, rectangular grid, consider a ``polar grid'' in
  the <m>z</m>-plane consisting of concentric circles centered at the
  origin and radial lines emerging from the origin.  
  Sketch such a
  grid and then sketch the image of this grid.</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>Remember that <m>\ds\cos(\theta) = \frac{e^{i\theta} +
    e^{-i\theta}}{2}</m>.  Suppose we define <m>\ds\cos(z) = \frac{e^{iz} +
    e^{-iz}}{2}</m>.</p>
    </introduction>
    <task workspace="2.5in">
      <statement>
        <p>Find functions <m>u(x,y)</m> and <m>v(x,y)</m> such that
  <m>\cos(x+iy) = u(x,y) + iv(x,y)</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Find the points <m>z</m> for which <m>\cos(z) = 2</m>.</p>
      </statement>
    </task>
  </exercise>

</worksheet>
