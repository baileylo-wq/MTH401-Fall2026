<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
    <title>3.5. Contour integrals</title>

    <alert>
        MTH 401
    </alert>

    <definition xml:id="def-contour-integral">
        <statement>
            <p>
                For a function <m>f(z)=u+iv</m> where <m>z=x+iy</m>, a
                <term>contour integral</term> on a curve <m>C</m> has the form
                (in rectangular coordinates)
                <md>
                    \int\limits_C f(z)~dz = \int\limits_C (u+iv)(dx+idy) = \int\limits_C u~dx - v~dy + i\int_C v~dx + u~dy.
                </md>
            </p>
        </statement>
    </definition>

    <exercise>
        <introduction>
            <p>
                Evaluate <m>\int_C z~dz</m> where
            </p>
        </introduction>

        <task workspace="1in">
            <statement>
                <p>
                    <m>C</m> is the straight line from <m>0</m> to <m>1+i</m>.
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    <m>C</m> is the contour consisting of two straight line segments
                    from <m>0</m> to <m>1</m> and from <m>1</m> to <m>1+i</m>.
                </p>
            </statement>
        </task>
    </exercise>

    <exercise >
        <introduction>
            <p>
                Let's consider the slightly more interesting function <m>f(z)=\overline{z}</m>.
            </p>
        </introduction>
        <task workspace="1in">
            <statement>
                <p>
                    Evaluate <m>\oint_C \overline{z}~dz</m> where <m>C</m> is
                    the unit square ( <m>0\leq x \leq 1</m> and
                    <m>0\leq y \leq 1</m> ) traversed in the counterclockwise
                    direction.
                </p>
            </statement>
        </task>

        <task workspace="1.4in">
            <statement>
                <p>
                    Suppose that <m>C</m> is a closed contour bounding a region
                    whose area is <m>A</m>.
                    Use Green's theorem to explain why
                    <m>{\oint_C \overline{z}~dz = 2iA}</m>.
                </p>
            </statement>
        </task>
    </exercise>

    <exercise >
        <introduction>
            <p>
                Suppose that <m>C</m> is the unit circle traversed in the
                counterclockwise direction.
            </p>
        </introduction>

        <task workspace="3in" >
            <statement>
                <p>
                    Parameterize the unit circle as <m>z(t) = e^{it}</m> to
                    evaluate the following:
                </p>
                <ul>
                    <li>
                        <p>
                            <m>\oint\limits_C z~dz</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>\oint\limits_C z^3~dz</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>\oint\limits_C \frac1z~dz</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>\oint\limits_C \frac1{z^3}~dz</m>
                        </p>
                    </li>
                </ul>
            </statement>

    

    


        </task>

        <task workspace="1in">
            <statement>
                <p>
                    What is the general rule for <m>\oint_Cz^n~dz</m>?
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Now suppose that <m>C</m> is the circle of radius <m>R</m>
                    centered at the origin parametrized as
                    <m>z(t) = Re^{it}</m>.
                    What do you find for <m>\oint_C z^n~dz</m>?
                </p>
            </statement>
        </task>
    </exercise>

    <exercise>
        <introduction>
            <p>
                Suppose that <m>C</m> is a closed contour and that <m>f(z)</m>
                is complex differentiable in the region <m>D</m> inside
                <m>C</m>.
            </p>
        </introduction>

        <task workspace="2in">
            <statement>
                <p>
                    Write <m>\oint_C f(z)~dz</m> as a line integral in terms of
                    <m>dx</m> and <m>dy</m>.
                    Then apply the Green's Theorem to evaluate the contour
                    integral.
                    What do you find for the value of <m>\oint_Cf(z)~dz</m>?
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    At the beginning of this worksheet, you evaluated
                    <m>\oint_C \overline{z}~dz</m> around the unit square.
                    Explain why your result shows that <m>\overline{z}</m> is
                    not complex differntiable.
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Since <m>z^n</m> is differentiable if <m>n\geq 0</m>, give
                    another explanation for why <m>{\oint_C z^n = 0}</m> if
                    <m>C</m> is the unit circle.
                </p>
            </statement>
        </task>
    </exercise>
</worksheet>