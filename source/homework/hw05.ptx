  <exercise>
        
                    
                    <statement>
                        <p>
                            Solve the wave equation:
                            <md>
                                \frac{\partial^2 u}{\partial t^2} = 4\frac{\partial^2 u}{\partial x^2}
                            </md>
                            where the length of the string is <m>\pi</m>, the ends are clamped (fixed) at 0, the initial position of the string is <m>\pi x - x^2</m>, and the initial velocity is 0.
                        </p>
                   
                            <p>
                                Use your favorite plotting software to plot the solution when <m>t=0</m> and when <m>t=1.0</m> on the same plot, and sketch the plot. (These are 1 dimensional plots since <m>t</m> is fixed.)
                            </p>

                            <p>
                                <em>Optional:</em> For a more informative picture, plot the solution in 2D over the time 0 to 4.
                            </p>
                        </statement>
      
                </exercise>

                <exercise>
                    
                    <statement>
                        <p>
                            Solve the wave equation:
                            <md>
                            
                                <mrow>\frac{\partial^2 u}{\partial t^2} \amp = 4 \frac{\partial^2 u}{\partial x^2} </mrow>
                                <mrow>\frac{\partial u}{\partial x}(0,t) \amp = 0 </mrow>
                                <mrow>\frac{\partial u}{\partial x}(\pi,t) \amp = 0 </mrow>
                                <mrow>u(x,0) \amp= \pi x - x^2 </mrow>
                                <mrow>\frac{\partial u}{\partial t}(x,0) \amp= 0 </mrow>
                                
                            </md>
                        </p>
                    </statement>
                </exercise>

                <exercise>
                    
                    <introduction>
                        <p>
                            For the function <m>f(x) = x^2</m> on the interval <m>[-1,1]</m>, do the following:
                        </p>
                    </introduction>
                    
                    <task>
                        <statement>
                            <p>Find the general Fourier series of <m>f(x)</m> on that interval.</p>
                        </statement>
                    </task>
                    
                    <task>
                        <statement>
                            <p>Plot your solution for the previous task using any plotting software and an appropriate number of terms, and sketch the plot.</p>
                        </statement>
                    </task>
                    
                    <task>
                        <statement>
                            <p>Does the Gibbs phenomenon occur? Why or why not?</p>
                        </statement>
                    </task>
                </exercise>

                <exercise>
                    
                    <introduction>
                        <p>
                            For the function
                            <md>
                                f(x) = \begin{cases}
                                1 \amp \text{if } -3 \leq x \lt 0 \\
                                -4 \amp \text{if } 0 \leq x \lt 3
                                \end{cases}
                            </md>
                            that is periodic with period 6, do the following:
                        </p>
                    </introduction>
                    
                    <task>
                        <statement>
                            <p>Find the general Fourier series of <m>f(x)</m> on that interval.</p>
                        </statement>
                    </task>
                    
                    <task>
                        <statement>
                            <p>Plot your solution for the previous task using any plotting software and an appropriate number of terms, and sketch the plot.</p>
                        </statement>
                    </task>
                    
                    <task>
                        <statement>
                            <p>Does the Gibbs phenomenon occur? Why or why not?</p>
                        </statement>
                    </task>
                </exercise>
    
   
